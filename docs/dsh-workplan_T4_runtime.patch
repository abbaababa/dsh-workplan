+      ok: false,
+      code: 'NO_ACTIVE_ATTEMPT',
+      error: `子任务 ${id} 当前没有可延期的执行中尝试`,
+      hint: '已收束的尝试不能复活：请转新轮续跑或人工裁决（escalate）',
