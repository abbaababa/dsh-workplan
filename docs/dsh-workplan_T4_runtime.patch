+      code: 'INVALID_EXTEND',
+      error: `extendMs 必须是正有限数（毫秒）：${String(extendMs)}`,
+      hint: '请传入 1 以上的毫秒数；需要更长时限请转新轮续跑或转 escalate',
+    }
+  }
+  const delta = Math.floor(amount)
+  const handle = record?.attemptHandles?.[id]
+  if (!handle || handle.settled) {
